# Local demo values. Copy to the repo root as `.env`.
# Compose and FastAPI read that file. Do not commit the real `.env`.

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=admin

KEYCLOAK_DB=keycloak
KEYCLOAK_USER=keycloak_user
KEYCLOAK_PASSWORD=keycloak_password

APP_DB=app
APP_USER=app_user
APP_PASSWORD=app_password

KEYCLOAK_API_SECRET=api-client-secret
KEYCLOAK_INGEST_SECRET=ingest-client-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

OPENSEARCH_INITIAL_ADMIN_PASSWORD=OpenSearchAdmin123!

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Internal ingest presign. Defaults live in app config; these are not required
# in the root .env. FastAPI still uses localhost:9000 for HEAD and GET.
# The presigned PUT host is the compose DNS name so a pipeline container can upload.
# Set MINIO_PRESIGN_ENDPOINT=localhost:9000 only when a host-side client must PUT the URL.
# MINIO_PRESIGN_ENDPOINT=minio:9000
# MINIO_PRESIGN_EXPIRY_SECONDS=3600
# PIPELINE_MAX_UPLOAD_BYTES=104857600
# Outbound connector control plane. Empty (the default) makes admin create return 503.
# Do not put source passwords in this file. The API forwards config and does not store it.
# INGESTION_PIPELINE_URL=
# INGESTION_PIPELINE_TIMEOUT_SECONDS=10
