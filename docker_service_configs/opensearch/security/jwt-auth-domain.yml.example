# THIS is the OpenSearch ↔ Keycloak connection config (OpenSearch 3.8).
#
# OpenSearch 3.3+ supports jwks_uri on http_authenticator.type: jwt.
# init_services PUTs this shape (no PEM copy on the happy path):
#   PUT /_plugins/_security/api/securityconfig/config
# Command: cd backend && uv run python -m init_services
#
# This file is reference only — compose does not mount it.
#
# Networking split (do not invert):
#   jwks_uri         = Keycloak Docker DNS  http://keycloak:8080/.../certs
#                      OpenSearch fetches keys from inside the compose network.
#   required_issuer  = public token iss     http://localhost:8080/realms/...
#                      Must match the JWT `iss` claim. localhost from the OS
#                      container is the WRONG fetch URL (connection refused).
#
# http_authenticator.type MUST be jwt, not openid. ${attr.jwt.*} DLS is empty
# with openid even when login succeeds.
#
# PEM signing_key is legacy/emergency fallback only (2.19 style). Omit it when
# jwks_uri is set; OpenSearch ignores signing_key if jwks_uri is present.
# Re-run init after changing jwks_uri / issuer / audience — not after Keycloak
# realm key rotation (JWKS cache picks up a new kid).
#
# jwt_auth_domain:
#   http_enabled: true
#   transport_enabled: true
#   order: 0
#   http_authenticator:
#     type: jwt
#     challenge: false
#     config:
#       jwks_uri: http://keycloak:8080/realms/enterprise-search-realm/protocol/openid-connect/certs
#       jwt_header: Authorization
#       subject_key: preferred_username
#       roles_key: roles
#       required_audience: api-client
#       required_issuer: http://localhost:8080/realms/enterprise-search-realm
#       jwt_clock_skew_tolerance_seconds: 30
#   authentication_backend:
#     type: noop
#
# Keep basic_internal_auth_domain enabled (ingest uses admin basic auth).
# Do not set required_issuer to the Docker DNS URL (http://keycloak:8080/...).
