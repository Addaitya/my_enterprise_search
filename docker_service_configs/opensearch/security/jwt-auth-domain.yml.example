# JWT domain fragment for OpenSearch 2.19.1. Merge via Security REST API
# (init_services/opensearch_security.py). This file is reference only — compose
# does not mount it.
#
# OpenSearch 2.19 has no working jwks_uri on the jwt authenticator (that is
# 3.3+). Fetch Keycloak realm `public_key` and wrap it as PEM in signing_key.
# Re-run init_services after Keycloak realm key rotation.
#
# http_authenticator.type MUST be jwt, not openid. ${attr.jwt.*} DLS is empty
# with openid even when login succeeds.
#
# jwt_auth_domain:
#   http_enabled: true
#   transport_enabled: true
#   order: 0
#   http_authenticator:
#     type: jwt
#     challenge: false
#     config:
#       signing_key: |
#         -----BEGIN PUBLIC KEY-----
#         <Keycloak realm public_key, wrapped at 64 chars>
#         -----END PUBLIC KEY-----
#       jwt_header: Authorization
#       subject_key: preferred_username
#       roles_key: roles
#       required_audience: api-client
#       required_issuer: http://localhost:8080/realms/enterprise-search-realm
#       jwt_clock_skew_tolerance_seconds: 30
#   authentication_backend:
#     type: noop
#
# Keep basic_internal_auth_domain enabled (ingest uses admin basic auth).
# Do not set required_issuer to the Docker DNS URL (http://keycloak:8080/...).
